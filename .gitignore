# ===== 构建产物（可由 ./scripts/sync_maps.sh 确定性重建）=====
build/
build-san/
build-*/
build2/
cmake-build-*/

# ===== 地图数据产物：4.2 GB，全部可重建，不入库 =====
# 路由图 + 显示瓦片 + 地标表 + 反向索引 + 地名库，全部由 sync_maps.sh 生成。
products/

# ===== 原始 OSM 数据：446 MB，从上游下载获得，不入库 =====
# 保留的是"从哪下载"的信息，不是数据本身。
sources/

# ===== 回归截图 / 渲染产物 =====
docs/shots/
*.bmp
*.png
!docs/**/*.png

# ===== 编译中间件 =====
*.o
*.a
*.so
*.d

# ===== 编辑器 / 系统 =====
.vscode/
*.swp
*~
.DS_Store

